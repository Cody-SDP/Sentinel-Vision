# Sentinel-Vision — Environment Variable Reference
# Copy this file to .env and adjust values as needed.
# None of these are required; they are all optional overrides.
# The application reads these automatically when set in your shell or .env file.
#
# SECURITY NOTE: Never commit a populated .env file to version control.
# .env is listed in .gitignore to prevent accidental exposure of secrets.

# ---------------------------------------------------------------------------
# detect_live.py — Inference
# ---------------------------------------------------------------------------

# Path to the YOLO weights file (.pt).
# Defaults to weights/best.pt if it exists, otherwise falls back to yolov8m.pt.
# MODEL_PATH=weights/best.pt

# Input source for inference.
# Use an absolute or relative file path for a video file, or '0' for the default webcam.
# If not set, the app prints usage instructions and exits.
# VIDEO_SOURCE=/path/to/video.mp4
# VIDEO_SOURCE=0

# Directory where annotated output is saved when --save-output is used.
# Defaults to runs/detect/output.
# OUTPUT_PATH=runs/detect/output

# Set to '1', 'true', or 'yes' to enable the live preview window without
# passing --show on the command line.
# Requires a graphical display to be available (not available inside Docker).
# SHOW_PREVIEW=false

# ---------------------------------------------------------------------------
# train.py — Training (contributor / production use)
# ---------------------------------------------------------------------------

# Path to the dataset YAML file used for training.
# Defaults to datasets/cctv/data.yaml (relative to the project root).
# DATASET_PATH=datasets/cctv/data.yaml

# Name for the training run (controls output directory under runs/detect/).
# Defaults to sentinel_v1.
# RUN_NAME=sentinel_v1

# Number of training epochs.
# Defaults to 1.
# EPOCHS=1
